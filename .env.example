# Microsoft Foundry / Azure OpenAI endpoint, without the deployment route.
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com

# Keep this secret. Do not commit a populated .env file.
FOUNDRY_API_KEY=

# This is the deployment name in your Foundry resource. It can differ from the model name.
FOUNDRY_DEPLOYMENT=gpt-image-2.5-sunburst

FOUNDRY_API_VERSION=2025-04-01-preview

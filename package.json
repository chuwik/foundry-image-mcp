{
  "name": "foundry-image-mcp",
  "version": "0.1.0",
  "description": "MCP server for image generation and editing with Microsoft Foundry",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "foundry-image-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude dist/**"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "microsoft-foundry",
    "azure-openai",
    "image-generation",
    "gpt-image"
  ],
  "author": "chuwik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuwik/foundry-image-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
